{
	"manifest_version": 3,
	"name": "Aethereal Shield",
	"version": "0.1.0",
	"description": "Lindungi aset kripto kamu dari situs phishing dan transaksi berbahaya.",
	"icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
	"permissions": ["storage"],
	"background": { "service_worker": "src/background.js", "type": "module" },
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["src/content.js"],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"web_accessible_resources": [
		{ "resources": ["src/inpage.js", "src/lib/tx.js"], "matches": ["<all_urls>"] }
	],
	"action": { "default_popup": "popup/popup.html", "default_title": "Aethereal Shield", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } }
}
