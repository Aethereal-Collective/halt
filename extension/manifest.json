{
	"manifest_version": 3,
	"name": "__MSG_extName__",
	"short_name": "__MSG_extShortName__",
	"default_locale": "id",
	"version": "0.1.1",
	"description": "__MSG_extDescription__",
	"icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
	"permissions": ["storage"],
	"background": { "service_worker": "src/background.js", "type": "module" },
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["src/content.js"],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"web_accessible_resources": [
		{ "resources": ["src/inpage.js", "src/lib/tx.js", "fonts/PlusJakartaSans.woff2"], "matches": ["<all_urls>"] }
	],
	"action": { "default_popup": "popup/popup.html", "default_title": "__MSG_extShortName__", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } }
}
